# AlphaDesk — copy to .env (or export in your shell). Reuses your existing keys.
# Each source is optional; missing ones fall back to sample data.

# Alpaca (price history + current price)
ALPACA_KEY=your_alpaca_key_id
ALPACA_SECRET=your_alpaca_secret
# ALPACA_DATA_URL=https://data.alpaca.markets   # default; override if needed

# Polygon (company reference: shares outstanding, etc.) — either name works
POLYGON_KEY=your_polygon_key
# POLYGON_API_KEY=your_polygon_key

# Finnhub (P/E, beta, margins, 52w range, dividend yield)
FINNHUB_KEY=your_finnhub_key

# SEC EDGAR requires a descriptive User-Agent (free, no key)
EDGAR_USER_AGENT=AlphaDesk you@example.com

# Anthropic (optional) — enables the Claude filing reader: real narrative analysis
# of the SEC filing text instead of the keyword heuristic. Falls back to the
# heuristic if unset or the `anthropic` package isn't installed.
ANTHROPIC_API_KEY=your_anthropic_api_key
# ALPHADESK_LLM_MODEL=claude-opus-4-8   # default; override to use another model
